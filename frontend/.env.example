# Sao chép thành .env.local khi chạy "npm run dev"
VITE_API_URL=http://localhost:3000/api/v1
# oidc: đăng nhập qua Keycloak · dev: chọn tài khoản demo (backend cũng phải chạy AUTH_MODE=dev)
VITE_AUTH_MODE=oidc
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/hr
VITE_OIDC_CLIENT_ID=hr-web
# Chỉ khi dùng Cognito (staging): URL /logout của Hosted UI. Để trống với Keycloak.
VITE_OIDC_LOGOUT_URL=
# Phút không thao tác thì tự đăng xuất, cảnh báo trước 1 phút (UC8 AC-8.1.6). Đặt 2 để thử nhanh.
VITE_IDLE_TIMEOUT_MINUTES=30
