# Sao chép thành .env khi chạy backend ngoài Docker (npm run start:dev).
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USER=hr
DB_PASSWORD=hr
DB_NAME=hr

# oidc: xác thực token Keycloak thật · dev: token "dev:<email>" (chỉ để test, bị chặn ở production)
AUTH_MODE=oidc
OIDC_ISSUER=http://localhost:8080/realms/hr
OIDC_JWKS_URI=http://localhost:8080/realms/hr/protocol/openid-connect/certs
OIDC_ALLOWED_CLIENTS=hr-web,hr-api-test

# 32 byte base64. Tạo khóa mới: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWRvLW5vdC11c2UtaW4tcHJvZCE=

# Message Queue (RabbitMQ) - dùng cho outbox publisher (API) và worker (event tài khoản)
# Queue cho outbox và worker: rabbitmq (local) hoặc sqs (AWS). Không đặt thì suy ra từ RABBITMQ_URL / SQS_QUEUE_URL.
QUEUE_DRIVER=rabbitmq
RABBITMQ_URL=amqp://hr:hr@localhost:5672
# Khi QUEUE_DRIVER=sqs (staging): quyền lấy từ IAM role của App Runner / ECS task, không cần access key.
# SQS_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/<account>/<queue>
# AWS_REGION=ap-southeast-1

# Queue event tài khoản (UC8) khi sqs: API gửi vào, worker nghe. RabbitMQ dùng queue identity.sync, không cần biến.
# SQS_IDENTITY_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/<account>/<queue>

# Email do services/notification gửi (ADR-15 bước 1): biến MAIL_DRIVER, SMTP_* đặt cho service đó, không đặt ở backend.

# Đồng bộ tài khoản sang IdP (UC8 identity-sync, chạy trong worker): keycloak (local) | cognito (staging) | none (mặc định: không gọi IdP)
# IDP_ADMIN_DRIVER=keycloak
# KEYCLOAK_ADMIN_URL=http://localhost:8080        # mặc định: OIDC_ISSUER bỏ /realms/<realm>
# KEYCLOAK_REALM=hr
# KEYCLOAK_ADMIN_CLIENT_ID=hr-api-admin
# KEYCLOAK_ADMIN_CLIENT_SECRET=dev-only-hr-api-admin-secret   # khớp keycloak/realm-hr.json
# COGNITO_USER_POOL_ID=ap-southeast-1_xxxxxxxx    # khi cognito; quyền cognito-idp:Admin* lấy từ IAM role của worker
# IDP_SYNC_ATTEMPTS=5
# IDP_SYNC_RETRY_DELAY_MS=1000

# Khác nhau giữa Keycloak (local, mặc định) và Cognito (staging):
#   OIDC_CLIENT_CLAIM: azp (Keycloak) | client_id (Cognito)
#   OIDC_USERINFO_URL: để trống với Keycloak; Cognito: https://<domain>.auth.<region>.amazoncognito.com/oauth2/userInfo
#     (access token Cognito không có email, API lấy email từ userinfo và cache theo sub 10 phút)

# TLS tới PostgreSQL: off (local) | require | verify (cần DB_SSL_CA_FILE trỏ tới CA bundle của RDS)
DB_SSL=off
# DB_SSL_CA_FILE=/app/certs/rds-global-bundle.pem
# NODE_ENV=production bắt buộc có FIELD_ENCRYPTION_KEY (không phải khóa dev), DB_PASSWORD, OIDC_ISSUER.
# Chỉ docker-compose local đặt ALLOW_DEV_SECRETS=true để bỏ qua kiểm tra này.

# Kho tài liệu và file hồ sơ (S3 trên AWS, S3Mock/MinIO khi chạy local: cần `docker compose up -d s3mock`).
# Để trống STORAGE_BUCKET hoặc PROFILE_STORAGE_BUCKET thì các API tương ứng trả 503.
STORAGE_BUCKET=hr-documents
PROFILE_STORAGE_BUCKET=hr-profile-files-local
STORAGE_ENDPOINT=http://localhost:9090          # bỏ trống trên AWS
STORAGE_PUBLIC_ENDPOINT=http://localhost:9090   # địa chỉ trình duyệt dùng để upload (khi API chạy trong Docker)
STORAGE_ACCESS_KEY_ID=test                      # chỉ local; trên AWS dùng IAM role
STORAGE_SECRET_ACCESS_KEY=test

# Giới hạn tần suất (NFR-5.21). Đổi ngưỡng từng nhóm bằng JSON, ví dụ khi load test:
# RATE_LIMIT_OVERRIDES={"global":{"minute":1000}}
# RATE_LIMIT_ENABLED=true
