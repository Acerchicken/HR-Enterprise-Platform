# Sao chép thành .env khi chạy backend ngoài Docker (npm run start:dev).
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USER=hr
DB_PASSWORD=hr
DB_NAME=hr

# oidc: xác thực token Keycloak thật · dev: token "dev:<email>" (chỉ để test, bị chặn ở production)
AUTH_MODE=oidc
OIDC_ISSUER=http://localhost:8080/realms/hr
OIDC_JWKS_URI=http://localhost:8080/realms/hr/protocol/openid-connect/certs
OIDC_ALLOWED_CLIENTS=hr-web,hr-api-test

# 32 byte base64. Tạo khóa mới: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWRvLW5vdC11c2UtaW4tcHJvZCE=

# Message Queue (RabbitMQ) - dùng cho outbox publisher và worker
# Queue cho outbox và worker: rabbitmq (local) hoặc sqs (AWS). Không đặt thì suy ra từ RABBITMQ_URL / SQS_QUEUE_URL.
QUEUE_DRIVER=rabbitmq
RABBITMQ_URL=amqp://hr:hr@localhost:5672
# Khi QUEUE_DRIVER=sqs (staging): quyền lấy từ IAM role của App Runner / ECS task, không cần access key.
# SQS_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/<account>/<queue>
# AWS_REGION=ap-southeast-1

# Mail server (Mailpit khi chạy local) - dùng cho notification worker
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@hr.local

# Khác nhau giữa Keycloak (local, mặc định) và Cognito (staging):
#   OIDC_CLIENT_CLAIM: azp (Keycloak) | client_id (Cognito)
#   OIDC_ROLES_CLAIM: realm_access.roles (Keycloak) | cognito:groups (Cognito)
#   OIDC_USERINFO_URL: để trống với Keycloak; Cognito: https://<domain>.auth.<region>.amazoncognito.com/oauth2/userInfo
#     (access token Cognito không có email, API lấy email từ userinfo và cache theo sub 10 phút)

# TLS tới PostgreSQL: off (local) | require | verify (cần DB_SSL_CA_FILE trỏ tới CA bundle của RDS)
DB_SSL=off
# DB_SSL_CA_FILE=/app/certs/rds-global-bundle.pem
# NODE_ENV=production bắt buộc có FIELD_ENCRYPTION_KEY (không phải khóa dev), DB_PASSWORD, OIDC_ISSUER.
# Chỉ docker-compose local đặt ALLOW_DEV_SECRETS=true để bỏ qua kiểm tra này.
