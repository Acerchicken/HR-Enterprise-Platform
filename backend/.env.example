# Sao chép thành .env khi chạy backend ngoài Docker (npm run start:dev).
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USER=hr
DB_PASSWORD=hr
DB_NAME=hr

# oidc: xác thực token Keycloak thật · dev: token "dev:<email>" (chỉ để test, bị chặn ở production)
AUTH_MODE=oidc
OIDC_ISSUER=http://localhost:8080/realms/hr
OIDC_JWKS_URI=http://localhost:8080/realms/hr/protocol/openid-connect/certs
OIDC_ALLOWED_CLIENTS=hr-web,hr-api-test

# 32 byte base64. Tạo khóa mới: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWRvLW5vdC11c2UtaW4tcHJvZCE=
