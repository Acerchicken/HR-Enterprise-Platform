{
  "realm": "hr",
  "enabled": true,
  "displayName": "HRHelper – HR Enterprise Platform",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "bruteForceProtected": true,
  "resetPasswordAllowed": true,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@hr.local",
    "fromDisplayName": "HRHelper",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "eventsEnabled": true,
  "eventsExpiration": 604800,
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "UPDATE_PASSWORD",
    "SEND_RESET_PASSWORD",
    "EXECUTE_ACTIONS"
  ],
  "adminEventsEnabled": true,
  "roles": {
    "realm": [
      {
        "name": "employee",
        "description": "Nhân viên"
      },
      {
        "name": "hr",
        "description": "Nhân sự"
      },
      {
        "name": "admin",
        "description": "Quản trị hệ thống"
      }
    ]
  },
  "clients": [
    {
      "clientId": "hr-web",
      "name": "HRHelper SPA",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      }
    },
    {
      "clientId": "hr-api-test",
      "name": "Client chỉ dùng cho test bằng curl/Postman (password grant)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true
    },
    {
      "clientId": "hr-api-admin",
      "name": "Worker identity-sync: tạo, khóa tài khoản qua Admin API (UC8 FR-8.3, 8.4)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-only-hr-api-admin-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
