# Biến môi trường mẫu cho toàn bộ hệ thống HR Platform (chạy local)
# Backend
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=hr
DB_PASSWORD=hr
DB_NAME=hr

# Identity & Access (Keycloak OIDC)
AUTH_MODE=oidc
OIDC_ISSUER=http://localhost:8080/realms/hr
OIDC_JWKS_URI=http://localhost:8080/realms/hr/protocol/openid-connect/certs
OIDC_ALLOWED_CLIENTS=hr-web,hr-api-test

# Field-level Encryption (AES-256 32-byte Base64)
FIELD_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWRvLW5vdC11c2UtaW4tcHJvZCE=

# Message Queue (RabbitMQ)
RABBITMQ_URL=amqp://hr:hr@localhost:5672
RABBITMQ_DEFAULT_USER=hr
RABBITMQ_DEFAULT_PASS=hr

# Mail server (Mailpit khi chạy local)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@hr.local

# Frontend
VITE_API_URL=http://localhost:3000/api/v1
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/hr
VITE_OIDC_CLIENT_ID=hr-web
