{
  "name": "hr-notification-service",
  "version": "0.1.0",
  "private": true,
  "description": "HRHelper notification service (ADR-15 bước 1): nhận event nghỉ phép, hồ sơ từ queue và gửi email (SMTP local, SES trên AWS)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node --transpile-only src/main.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "testTimeout": 30000
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1177.0",
    "@aws-sdk/client-sqs": "^3.1177.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-pg": "0.76.0",
    "@opentelemetry/instrumentation-undici": "0.33.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "amqplib": "^0.10.9",
    "nodemailer": "^6.10.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.23.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
